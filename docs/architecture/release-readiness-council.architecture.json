  "cards": [
    {
      "dot": "cyan",
      "title": "Orchestration",
      "items": [
        "Chair gathers evidence once and is the only role with tool access",
        "Six reviewers run in parallel; each returns the same opinion JSON contract"
      ]
    },
    {
      "dot": "amber",
      "title": "Deliberation rules",
      "items": [
        "No evidence, no weight: unsupported claims are excluded",
        "Splits are reported, never averaged",
        "A missing required reviewer makes the result INCOMPLETE"
      ]
    },
    {
      "dot": "rose",
      "title": "Human gate",
      "items": [
        "Output is RECOMMEND_GO, GO_WITH_CONDITIONS, HOLD or INCOMPLETE",
        "Only the named release owner decides and signs the record"
      ]
    }
  ]
